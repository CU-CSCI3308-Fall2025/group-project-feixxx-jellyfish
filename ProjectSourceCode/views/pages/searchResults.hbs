{{! views/pages/searchResults.hbs }}
<h1>Search Results</h1>

<p>Showing results for: <strong>{{query}}</strong></p>

{{#if results.length}}
  <div class="search-stats">
    <p>Found {{results.length}} plant(s)</p>
  </div>
  
  <div class="gallery-grid">
    {{#each results}}
      <div class="plant-card">
        <a href="/plants/{{this.plant_id}}" class="plant-card-link">
          {{#if this.photo_url}}
            <img src="{{this.photo_url}}" alt="{{this.name}}" 
                 onerror="this.src='/assets/placeholder-plant.jpg'">
          {{else}}
            <div class="no-image">No image</div>
          {{/if}}
          <div class="plant-card-content">
            <h3>{{this.name}}</h3>
            {{#if this.sci_name}}
              <p class="sci-name">{{this.sci_name}}</p>
            {{/if}}
            <p>Bloom Season: {{this.bloom_season}}</p>
            {{#if this.plant_type}}
              <p>Type: {{this.plant_type}}</p>
            {{/if}}
            <span class="view-details">View Details →</span>
          </div>
        </a>
      </div>
    {{/each}}
  </div>
{{else}}
  <div class="no-results">
    <p>No plants found matching your search.</p>
    <a href="/search" class="btn">Try a new search</a>
  </div>
{{/if}}

<style>
  .search-stats {
    margin-bottom: 20px;
    color: #666;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 25px;
    margin-top: 20px;
  }

  .plant-card {
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background: white;
  }

  .plant-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
  }

  .plant-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
  }

  .plant-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .no-image {
    width: 100%;
    height: 200px;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
  }

  .plant-card-content {
    padding: 20px;
  }

  .plant-card h3 {
    margin-top: 0;
    margin-bottom: 10px;
    color: #2c3e50;
  }

  .sci-name {
    font-style: italic;
    color: #7f8c8d;
    margin-bottom: 10px;
    font-size: 0.9em;
  }

  .plant-card p {
    margin: 5px 0;
    color: #555;
    font-size: 0.95em;
  }

  .view-details {
    display: inline-block;
    margin-top: 10px;
    color: #4CAF50;
    font-weight: bold;
    font-size: 0.9em;
  }

  .no-results {
    text-align: center;
    padding: 40px 20px;
    background-color: #f9f9f9;
    border-radius: 8px;
    margin-top: 30px;
  }

  .no-results p {
    font-size: 1.1em;
    color: #666;
    margin-bottom: 20px;
  }

  .btn {
    display: inline-block;
    padding: 10px 20px;
    background-color: #4CAF50;
    color: white;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
  }

  .btn:hover {
    background-color: #45a049;
  }

  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    }
  }

  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>